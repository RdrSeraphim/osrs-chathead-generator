{
  "name": "osrs-chathead-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:server": "esbuild src/server/prodServer.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "preview": "vite preview",
    "start": "node dist/server.mjs",
    "test": "vitest run",
    "fetch-cache": "tsx scripts/fetch-openrs2-cache.ts",
    "generate-og-image": "tsx scripts/generate-og-image.ts"
  },
  "dependencies": {
    "@abextm/cache2": "^0.1.11",
    "@microsoft/focusgroup-polyfill": "^1.6.0",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "pako": "^2.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "seek-bzip": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pako": "^2.0.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
